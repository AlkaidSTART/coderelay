{
  "name": "@alkaidstart/coderelay",
  "version": "0.4.4",
  "publishConfig": {
    "access": "public"
  },
  "module": "index.ts",
  "type": "module",
  "files": [
    "src",
    "index.ts"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "scripts": {
    "dev": "bun run desktop:dev",
    "start": "bun run desktop:dev",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "issues:doc": "bun scripts/generate-issues-doc.ts",
    "desktop:dev": "cd apps/desktop && bunx tauri dev",
    "desktop:build": "cd apps/desktop && bunx tauri build",
    "desktop:typecheck": "bun run --cwd apps/desktop typecheck",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "sdk:build": "bun run --cwd packages/sdk-ts build",
    "sdk:typecheck": "bun run --cwd packages/sdk-ts typecheck",
    "sdk:test": "bun run --cwd packages/sdk-ts test",
    "legacy:dev": "bun src/cli.tsx",
    "cli": "cargo run -p coderelay-cli --",
    "cli:build": "cargo build --release -p coderelay-cli",
    "cli:install": "cargo install --path crates/coderelay-cli --locked",
    "version:check": "bun scripts/check-versions.ts",
    "check": "bun run version:check && bun run typecheck && bun test && bun run sdk:typecheck && bun run sdk:test && bun run rust:fmt && bun run rust:clippy && bun run rust:test"
  },
  "bin": {
    "coderelay": "src/cli.ts",
    "cr": "src/cli.ts"
  },
  "workspaces": [
    "apps/desktop",
    "packages/sdk-ts"
  ]
}
